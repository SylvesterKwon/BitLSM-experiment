        "force_composite"
      ]
    },
    {
      "engine": "innodb",
      "index_layout": "sk_v1",
      "engine_params": {
        "hist": "v1"
      },
      "plans": [
        "auto"
      ]
    },
    {
      "engine": "innodb",
      "index_layout": "composite_v1",
      "engine_params": {
        "hist": "v1"
      },
      "plans": [
        "force_composite"
      ]
    }
  ]
