{
  "workload": "pbi_taxpayer",
  "build_kind": "release",
  "queries": "all",
  "warm_reps": 5,
  "server_common": {
    "cache_bytes": 1073741824,
    "direct_io": true,
    "relaxed_commit_flush": true
  },
  "cells": [
    {
      "engine": "bitlsm",
      "index_layout": "bi_v1",
      "plans": [
        "auto",
        "force_bi"
      ]
    },
    {
      "engine": "bitlsm",
      "index_layout": "sk_bi_v1",
      "plans": [
        "auto",
        "force_bi",
        "ignore_bi"
      ]
    },
    {
      "engine": "myrocks",
      "index_layout": "sk_v1",
      "plans": [
        "auto",
        "index_merge"
      ]
    },
    {
      "engine": "myrocks",
      "index_layout": "composite_v1",
      "engine_params": {
        "hist": "v1"
      },
      "plans": [
        "force_composite"
      ]
    },
    {
      "engine": "innodb",
      "index_layout": "sk_v1",
      "engine_params": {
        "hist": "v1"
      },
      "plans": [
        "auto",
        "index_merge"
      ]
    },
    {
      "engine": "innodb",
      "index_layout": "sk_v1",
      "engine_params": {
        "hist": "v1"
      },
      "session_vars": {
        "optimizer_switch": "'index_merge_intersection=off'"
      },
      "plans": [
        "auto"
      ]
    },
    {
      "engine": "innodb",
      "index_layout": "composite_v1",
      "engine_params": {
        "hist": "v1"
      },
      "plans": [
        "force_composite"
      ]
    }
  ]
}
