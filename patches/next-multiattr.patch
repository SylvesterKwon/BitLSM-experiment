+// NEXT (Phase 4, Task 4.1): a minimal InternalIteratorBase<IndexValue> that
+// walks a FIXED, already-intersected list of PRIMARY data-block handles for
+// one SST file. Fed into a real BlockBasedTableIterator in place of the
+// normal per-SST index/sec-index reader, so the IM final scan reuses the
+// EXISTING data-block-reading machinery (InitDataBlock ->
+// NewDataBlockIterator<kData>) completely unchanged -- only WHICH blocks
+// get visited differs from PF.
+//
+// Only the methods exercised by a SeekToFirst()+Next() full-scan (this
+// project's only access pattern for secondary-index scans -- see the
+// `for (it->SeekToFirst(); it->Valid(); it->Next())` loop in
+// src/next_driver/next_honk.cpp) are meaningfully implemented. The others
+// mirror OneDRtreeSecIndexIterator's own stubs (table/block_based/
+// onedrtree_sec_index_iterator.h): never called on this path, since the
+// driver never sets ReadOptions::iterate_upper_bound and never calls
+// Seek()/SeekForPrev()/Prev() on the returned rocksdb::Iterator.
+class IMBlockHandleIndexIterator : public InternalIteratorBase<IndexValue> {
+ public:
+  explicit IMBlockHandleIndexIterator(std::vector<BlockHandle> handles)
+      : handles_(std::move(handles)) {}
+
+  bool Valid() const override { return pos_ < handles_.size(); }
+  void SeekToFirst() override { pos_ = 0; }
+  void SeekToLast() override {
+    pos_ = handles_.empty() ? 0 : handles_.size() - 1;
+  }
+  void Seek(const Slice& /*target*/) override { assert(false); }
+  void SeekForPrev(const Slice& /*target*/) override { assert(false); }
+  void Next() override {
+    assert(Valid());
+    pos_++;
+  }
+  void Prev() override {
+    assert(Valid());
+    if (pos_ == 0) {
+      pos_ = handles_.size();
+    } else {
+      pos_--;
+    }
+  }
+  Slice key() const override {
+    assert(false);
+    return Slice();
+  }
+  Slice user_key() const override {
+    assert(false);
+    return Slice();
+  }
+  IndexValue value() const override {
+    assert(Valid());
+    return IndexValue(handles_[pos_], Slice());
+  }
+  Status status() const override { return Status::OK(); }
+
+ private:
+  std::vector<BlockHandle> handles_;
+  size_t pos_ = 0;
+};
