+BlockBasedTable* Version::GetBlockBasedTableForIM(
+    const ReadOptions& read_options, const FileOptions& soptions,
+    const FileMetaData& file_meta, Cache::Handle** cache_handle) {
+  *cache_handle = nullptr;
+  TableReader* table_reader = file_meta.fd.table_reader;
+  if (table_reader == nullptr) {
+    Status s = cfd_->table_cache()->FindTable(
+        read_options, soptions, cfd_->internal_sec_comparator(), file_meta,
+        cache_handle, mutable_cf_options_.prefix_extractor);
+    if (!s.ok()) {
+      return nullptr;
+    }
+    table_reader = cfd_->table_cache()->GetTableReaderFromHandle(*cache_handle);
+  }
+  return static_cast<BlockBasedTable*>(table_reader);
+}
