+void Version::AddIteratorsForLevelIndexMerge(
+    const ReadOptions& read_options, const FileOptions& soptions,
+    MergeIteratorBuilder* merge_iter_builder, RtreeIteratorContext* context) {
+  auto* arena = merge_iter_builder->GetArena();
+
+  // Enumerate each predicate's own candidate set, then intersect by
+  // (filenum, offset). Starting from the first predicate and narrowing
+  // keeps this O(sum of candidate sizes) rather than materializing every
+  // set before intersecting.
+  std::map<uint64_t, std::map<uint64_t, uint64_t>> intersected;
+  bool first = true;
+  for (const auto& pred : context->im_predicates) {
+    uint32_t attr_id = pred.first;
+    Slice query_slice(pred.second);
+    std::map<uint64_t, std::map<uint64_t, uint64_t>> candidates =
+        EnumerateIMCandidateDataBlocks(attr_id, query_slice, read_options,
+                                      soptions);
+    if (first) {
+      intersected = std::move(candidates);
+      first = false;
+      continue;
+    }
+    for (auto it = intersected.begin(); it != intersected.end();) {
+      auto other_it = candidates.find(it->first);
+      if (other_it == candidates.end()) {
+        it = intersected.erase(it);
+        continue;
+      }
+      auto& mine = it->second;
+      const auto& theirs = other_it->second;
+      for (auto mit = mine.begin(); mit != mine.end();) {
+        if (theirs.find(mit->first) == theirs.end()) {
+          mit = mine.erase(mit);
+        } else {
+          ++mit;
+        }
+      }
+      if (mine.empty()) {
+        it = intersected.erase(it);
+      } else {
+        ++it;
+      }
+    }
+    if (intersected.empty()) {
+      break;
+    }
+  }
+
+  // Scan ONLY the intersected data blocks per file. No single-attribute
+  // per-tuple filter here (unlike the PF path's block.cc value-range
+  // filter) -- the driver (src/next_driver/next_honk.cpp) re-checks every
+  // predicate via Matches() on every tuple this returns.
+  TruncatedRangeDelIterator* tombstone_iter = nullptr;
+  for (const auto& file_entry : intersected) {
+    uint64_t hfile_number = file_entry.first;
+    if (file_entry.second.empty()) {
+      continue;
+    }
+    auto hfile_loc = storage_info_.GetFileLocation(hfile_number);
+    if (hfile_loc.GetLevel() == -1) {
+      continue;
+    }
+    const auto& file = storage_info_.LevelFilesBrief(hfile_loc.GetLevel())
+                           .files[hfile_loc.GetPosition()];
+
+    Cache::Handle* cache_handle = nullptr;
+    BlockBasedTable* bbt = GetBlockBasedTableForIM(
+        read_options, soptions, *file.file_metadata, &cache_handle);
+    if (bbt == nullptr) {
+      continue;
+    }
+
+    std::vector<BlockHandle> handles;
+    handles.reserve(file_entry.second.size());
+    for (const auto& kv : file_entry.second) {
+      handles.emplace_back(kv.first, kv.second);
+    }
+
+    std::unique_ptr<InternalIteratorBase<IndexValue>> index_iter(
+        new IMBlockHandleIndexIterator(std::move(handles)));
+
+    // IMPORTANT: BlockBasedTableIterator's data-block read
+    // (InitDataBlock -> NewDataBlockIterator<kData>, see
+    // table/block_based/block_based_table_reader_impl.h) dispatches on
+    // ro.iterator_context: non-null routes into the secondary-index
+    // per-tuple filter machinery (NewSecondaryIndexDataIterator1D /
+    // NewSpatialDataIterator depending on ro.is_secondary_index_scan/
+    // is_secondary_index_spatial) -- i.e. exactly the single-attribute
+    // filter IM must NOT apply. A heap copy of read_options with
+    // iterator_context nulled out routes into the plain, unfiltered
+    // Block::NewDataIterator instead, so every tuple in the intersected
+    // blocks comes back for the driver to post-filter. Heap (not arena)
+    // allocated so its lifetime is independent of table_iter's, and freed
+    // via RegisterCleanup below regardless of which allocator table_iter
+    // itself used.
+    ReadOptions* scan_ro = new ReadOptions(read_options);
+    scan_ro->iterator_context = nullptr;
+
+    InternalIterator* table_iter;
+    if (arena == nullptr) {
+      table_iter = new BlockBasedTableIterator(
+          bbt, *scan_ro, cfd_->internal_sec_comparator(),
+          std::move(index_iter), /*check_filter=*/false,
+          /*need_upper_bound_check=*/false, /*prefix_extractor=*/nullptr,
+          TableReaderCaller::kUserIterator);
+    } else {
+      void* mem = arena->AllocateAligned(sizeof(BlockBasedTableIterator));
+      table_iter = new (mem) BlockBasedTableIterator(
+          bbt, *scan_ro, cfd_->internal_sec_comparator(),
+          std::move(index_iter), /*check_filter=*/false,
+          /*need_upper_bound_check=*/false, /*prefix_extractor=*/nullptr,
+          TableReaderCaller::kUserIterator);
+    }
+    table_iter->RegisterCleanup(&DeleteHeapReadOptions, scan_ro, nullptr);
+    if (cache_handle != nullptr) {
+      table_iter->RegisterCleanup(&ReleaseIMTableCacheHandle,
+                                  cfd_->table_cache(), cache_handle);
+    }
+
+    if (read_options.ignore_range_deletions) {
+      merge_iter_builder->AddIterator(table_iter);
+    } else {
+      merge_iter_builder->AddPointAndTombstoneIterator(table_iter,
+                                                       tombstone_iter);
+    }
+  }
 }
 
