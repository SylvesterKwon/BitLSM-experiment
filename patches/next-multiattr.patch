+std::map<uint64_t, std::map<uint64_t, uint64_t>>
+Version::EnumerateIMCandidateDataBlocks(uint32_t attr_id,
+                                        const Slice& query_slice,
+                                        const ReadOptions& read_options,
+                                        const FileOptions& soptions) {
+  // result[filenum][data_block_offset] = data_block_size.
+  std::map<uint64_t, std::map<uint64_t, uint64_t>> result;
+
+  if (global_rtrees_ == nullptr || attr_id >= global_rtrees_->size()) {
+    return result;  // no candidates -- bounds-guarded, not a crash.
+  }
+
+  // Step 1: global R-tree search for attr_id -- identical to the PF path's
+  // own search (version_set.cc AddIteratorsForLevel), just parameterized on
+  // attr_id instead of read_options.sec_attr_index. Yields candidate
+  // SEC-INDEX BLOCK handles (GlobalSecIndexValue::blkhandle), grouped by
+  // file.
+  ValueRange query_valrange = ReadValueRange(query_slice);
+  Rect1D query_rect1D(query_valrange.range.min, query_valrange.range.max);
+  std::vector<GlobalSecIndexValue> hittedFiles =
+      (*global_rtrees_)[attr_id].Search(query_rect1D.min, query_rect1D.max,
+                                        GlobalRTreeCallback);
+
+  std::map<uint64_t, std::vector<BlockHandle>> filenum_2_secblkhandle;
+  std::set<std::pair<uint64_t, uint64_t>> seen_file_offset;
+  for (const GlobalSecIndexValue& hf : hittedFiles) {
+    auto key = std::make_pair(hf.filenum, hf.blkhandle.offset());
+    if (seen_file_offset.insert(key).second) {
+      filenum_2_secblkhandle[hf.filenum].emplace_back(hf.blkhandle);
+    }
+  }
+
+  // Step 2: per file, walk attr_id's own per-SST sec-index scan (via
+  // BlockBasedTable::NewIndexIterator, is_secondary_index_scan=true --
+  // dispatches to OneDRtreeSecIndexReader::NewIterator, which builds a
+  // OneDRtreeSecIndexIterator over exactly the SEC-INDEX blocks named by
+  // found_sec_blkhandle below), collecting index_iter_->value().handle (the
+  // PRIMARY data-block handle each sec-index entry points to). This NEVER
+  // reads a kData block -- NewIndexIterator only touches BlockType::kIndex
+  // (sec-index) blocks; we stop at the sec-index entry's handle field
+  // without ever calling NewDataBlockIterator<..., BlockType::kData, ...>.
+  for (const auto& fkv : filenum_2_secblkhandle) {
+    uint64_t filenum = fkv.first;
+    auto floc = storage_info_.GetFileLocation(filenum);
+    if (floc.GetLevel() == -1) {
+      continue;
+    }
+    const auto& file =
+        storage_info_.LevelFilesBrief(floc.GetLevel()).files[floc.GetPosition()];
+
+    Cache::Handle* cache_handle = nullptr;
+    BlockBasedTable* bbt = GetBlockBasedTableForIM(
+        read_options, soptions, *file.file_metadata, &cache_handle);
+    if (bbt == nullptr) {
+      continue;
+    }
+
+    std::vector<std::pair<uint64_t, uint64_t>> local_found_sec_blkhandle;
+    local_found_sec_blkhandle.reserve(fkv.second.size());
+    for (const BlockHandle& bh : fkv.second) {
+      local_found_sec_blkhandle.emplace_back(bh.offset(), bh.size());
+    }
+
+    RtreeIteratorContext local_ctx;
+    local_ctx.query_mbr = query_slice.ToString();
+    local_ctx.sec_attr_index = attr_id;
+
+    ReadOptions local_ro = read_options;
+    local_ro.iterator_context = &local_ctx;
+    local_ro.is_secondary_index_scan = true;
+    local_ro.is_secondary_index_spatial = false;
+    local_ro.sec_attr_index = attr_id;
+    local_ro.found_sec_blkhandle = &local_found_sec_blkhandle;
+    local_ro.is_index_merge = false;
+
+    BlockCacheLookupContext lookup_context{TableReaderCaller::kUserIterator};
+    auto& file_result = result[filenum];
+    {
+      std::unique_ptr<InternalIteratorBase<IndexValue>> idx_iter(
+          bbt->NewIndexIterator(local_ro, /*need_upper_bound_check=*/false,
+                                /*input_iter=*/nullptr, /*get_context=*/nullptr,
+                                &lookup_context));
+      for (idx_iter->SeekToFirst(); idx_iter->Valid(); idx_iter->Next()) {
+        const BlockHandle& dbh = idx_iter->value().handle;
+        file_result[dbh.offset()] = dbh.size();
+      }
+    }
+
+    if (cache_handle != nullptr) {
+      cfd_->table_cache()->ReleaseHandle(cache_handle);
+    }
+  }
+
+  return result;
+}
